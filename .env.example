# AntiBridge: MAX <-> Telegram bridge bot (your own MAX account).

# --- Telegram ---
# TELEGRAM_GROUP_ID: add @userinfobot to your forum supergroup, send /id -> copy the negative id.
# TELEGRAM_OWNER_ID: open a PRIVATE chat with @userinfobot, send /id -> copy your user id.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here
TELEGRAM_GROUP_ID=-10026000111222     # closed forum SUPERGROUP (Topics enabled); bot is admin
TELEGRAM_OWNER_ID=123456789            # YOUR Telegram user id (only you run /sms, /max chats, /link, /topic, /unlink, /status)

# --- MAX (your personal account) ---
MAX_PHONE=+79991234567                 # phone that receives the SMS login code

# --- Optional ---
MAX_WORK_DIR=cache                     # directory for the MAX session (cache/main.db)
MAX_SESSION_NAME=main.db
DB_PATH=data/db.sqlite                 # bridge routing table (MAX chat_id <-> Telegram topic)

TG_LOG_LEVEL=WARNING                   # forward logs >= this level to Telegram feed (WARNING|ERROR|INFO)
